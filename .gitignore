## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Entity Framework Migrations (optionnel - décommentez si vous ne voulez pas versionner les migrations)
# **/Migrations/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Local database
*.db
*.db-shm
*.db-wal

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Sensitive configuration files (sans les secrets)
appsettings.Development.json
*secrets.json

# IDE - Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# Environment files
.env
.env.local
.env.*.local

# Sensitive configuration files (keep structure, remove secrets)
appsettings.Development.json
*secrets.json
*.user.secrets

